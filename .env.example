USER_AGENT=FEWURA-PROSPECT/1.0 contact@example.com
ALLOW_LIVE_SEND=false
DAILY_SEND_LIMIT=20
SEND_DELAY_SECONDS=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SENDER_COMPANY=FEWURA
SENDER_CONTACT_EMAIL=

# Meta WhatsApp Business Cloud API
